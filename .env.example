# Wallet-API configuration template.
# Copy to .env and fill in real values. .env is gitignored - never commit secrets.

# Database
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# App
PORT=3000

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Matrix / Synapse (Clariva homeserver)
# ---------------------------------------------------------------------------

# Client-Server API base URL. Note this is the matrix. subdomain, NOT the apex.
MATRIX_HOMESERVER_URL=https://matrix.clarivahub.com

# The homeserver's server_name - the bare apex. User IDs are @name:clarivahub.com
MATRIX_SERVER_NAME=clarivahub.com

# Synapse registration_shared_secret, from /root/matrix-credentials.txt on the VPS.
# Required: the homeserver runs enable_registration=false, so this is the only
# way to create accounts. Server-side only - never ship this to the app.
MATRIX_REGISTRATION_SHARED_SECRET=

# Optional. Access token for a Synapse admin (e.g. @shimil:clarivahub.com).
# Only needed to re-issue tokens for accounts that already exist, via
# POST /_synapse/admin/v1/users/{userId}/login. Obtain with:
#   curl -X POST https://matrix.clarivahub.com/_matrix/client/v3/login \
#     -H 'Content-Type: application/json' \
#     -d '{"type":"m.login.password",
#          "identifier":{"type":"m.id.user","user":"shimil"},
#          "password":"<admin password>"}'
MATRIX_ADMIN_TOKEN=

# Reserved for server-to-server callers. No longer guards the Matrix session
# route - that moved to POST /v1/auth/matrix-session behind a per-user JWT.
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=

# ---------------------------------------------------------------------------
# Clariva auth (email + password sign-up, no phone/OTP)
# ---------------------------------------------------------------------------

# Signs the session JWTs the app holds. The auth module REFUSES TO BOOT if this
# is unset, rather than signing forgeable tokens with an empty key.
# Generate with: openssl rand -hex 48
JWT_SECRET=

# Token lifetime. Mobile clients hold long sessions; shorten if you add refresh.
JWT_EXPIRES_IN=30d

# Google SSO. Use the WEB/server OAuth client ID from Google Cloud Console -
# Android Google Sign-In issues ID tokens whose `aud` is the WEB client ID, not
# the Android one. The Android client only binds package+SHA-1 to the project.
# Must match ClarivaConfig.GOOGLE_SERVER_CLIENT_ID in the app.
# Comma-separated to accept more than one client.
GOOGLE_CLIENT_IDS=

# ---------------------------------------------------------------------------
# CORS for the Clariva web app (browser clients)
# ---------------------------------------------------------------------------

# Comma-separated list of exact web origins allowed to call this API from a browser, e.g.
#   CORS_ORIGINS=https://app.clarivahub.com,http://localhost:8080
# Leave EMPTY to keep CORS disabled (Android, the clarivahub.com PHP proxy and the Razorpay
# webhook do not need it). Never use "*": list only origins you control.
CORS_ORIGINS=
