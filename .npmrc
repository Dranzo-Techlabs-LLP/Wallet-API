# typeorm@0.2.45 declares a peerOptional on ioredis@^4 while this project uses
# ioredis@^5, so a plain `npm install` aborts with ERESOLVE. The existing
# node_modules tree was built with this flag; pinning it here keeps cPanel and
# CI installs reproducible instead of failing on a fresh checkout.
legacy-peer-deps=true
